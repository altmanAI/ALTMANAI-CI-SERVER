{
  "name": "altmanai-ci-server",
  "version": "0.2.0",
  "private": true,
  "description": "AltmanAI's human-authorized CI governance and evidence server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "NODE_ENV=development node --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "find src test -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "verify-ledger": "node scripts/verify-ledger.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "license": "UNLICENSED"
}
