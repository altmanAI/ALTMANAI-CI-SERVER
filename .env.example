# Runtime. Use NODE_ENV=production outside local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Ingress hardening.
MAX_BODY_BYTES=1048576
WEBHOOK_RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# Enable only behind a trusted proxy that overwrites Fly-Client-IP/X-Forwarded-For.
TRUST_PROXY_HEADERS=false
GITHUB_REQUEST_TIMEOUT_MS=10000

# Required for GitHub webhook HMAC-SHA256 verification.
# Generate a unique high-entropy value and store it only in the platform secret manager.
WEBHOOK_SECRET=replace-with-a-high-entropy-secret

# Human authority and exact GitHub identity permitted to issue approval.
FOUNDER_NAME=Blake Hunter Altman
FOUNDER_GITHUB_LOGIN=altmanAI
FOUNDER_GITHUB_USER_ID=233472124
ALLOWED_GITHUB_OWNER=altmanAI
FOUNDER_APPROVAL_PHRASE=All Clear for Impact

# Repository-backed AI execution and authorization metadata.
AI_PARTNER_NAME=AltmanAI Model 2.0
AUTHORIZATION_RECORD_ID=ALTMANAI-CI-VERIFY-2026-07-13-001

# Required production authentication: GitHub App credentials.
# Preserve PEM newlines as \n when setting the private key as one environment value.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Development/emergency fallback only. Production use requires explicit opt-in and a recorded exception.
GITHUB_TOKEN=
ALLOW_STATIC_GITHUB_TOKEN=false

GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
POLICY_PATH=./config/policy.json
VERIFICATION_PATH=./config/verification.json

# Persistent evidence and backup paths. Mount durable storage at /app/data in production.
EVIDENCE_LEDGER_PATH=./data/evidence.ndjson
EVIDENCE_BACKUP_DIR=./data/backups
EVIDENCE_BACKUP_RETENTION_DAYS=30

SERVICE_NAME=altmanai-ci-server
SERVICE_VERSION=0.2.0
