NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
MAX_BODY_BYTES=1048576
GITHUB_REQUEST_TIMEOUT_MS=10000

# Required for GitHub webhook verification.
WEBHOOK_SECRET=replace-with-a-high-entropy-secret

# Human authority and exact GitHub identity permitted to issue approval.
FOUNDER_NAME=Blake Hunter Altman
FOUNDER_GITHUB_LOGIN=altmanAI
FOUNDER_GITHUB_USER_ID=233472124
ALLOWED_GITHUB_OWNER=altmanAI
FOUNDER_APPROVAL_PHRASE=All Clear for Impact

# Repository-backed AI execution and authorization metadata.
AI_PARTNER_NAME=AltmanAI Model 2.0
AUTHORIZATION_RECORD_ID=ALTMANAI-CI-VERIFY-2026-07-13-001

# Required production authentication: GitHub App credentials.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Development fallback only. Production use requires explicit opt-in.
GITHUB_TOKEN=
ALLOW_STATIC_GITHUB_TOKEN=false

GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
POLICY_PATH=./config/policy.json
VERIFICATION_PATH=./config/verification.json
EVIDENCE_LEDGER_PATH=./data/evidence.ndjson
SERVICE_NAME=altmanai-ci-server
SERVICE_VERSION=0.2.0
