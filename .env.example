NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
MAX_BODY_BYTES=1048576

# Required for GitHub webhook verification.
WEBHOOK_SECRET=replace-with-a-high-entropy-secret

# Exact GitHub login permitted to issue the standalone approval phrase.
FOUNDER_GITHUB_LOGIN=replace-with-founder-login
ALLOWED_GITHUB_OWNER=altmanAI
FOUNDER_APPROVAL_PHRASE=All Clear for Impact

# Preferred production authentication: GitHub App credentials.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Local-development fallback only. Do not commit a token.
GITHUB_TOKEN=

GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
POLICY_PATH=./config/policy.json
EVIDENCE_LEDGER_PATH=./data/evidence.ndjson
SERVICE_NAME=altmanai-ci-server
SERVICE_VERSION=0.1.0
