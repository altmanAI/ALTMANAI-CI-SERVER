# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
SERVICE_NAME=altmanai-ci-server
SERVICE_VERSION=0.2.0
LOG_LEVEL=info

# Request protection and GitHub API reliability.
MAX_BODY_BYTES=1048576
GITHUB_REQUEST_TIMEOUT_MS=10000
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=120

# Set true only behind a trusted platform proxy such as Fly.io or Railway.
# The service will then prefer Fly-Client-IP / X-Forwarded-For for rate limiting.
TRUST_PROXY_HEADERS=true

# Generate at least 32 random bytes and store only in the platform secret manager.
# During rotation, place the outgoing secret in WEBHOOK_SECRET_PREVIOUS, deploy the
# new WEBHOOK_SECRET, update GitHub, verify a ping, then remove the previous value.
WEBHOOK_SECRET=replace-with-a-high-entropy-secret
WEBHOOK_SECRET_PREVIOUS=

# Human authority and exact GitHub identity permitted to issue approval.
FOUNDER_NAME=Blake Hunter Altman
FOUNDER_GITHUB_LOGIN=altmanAI
FOUNDER_GITHUB_USER_ID=233472124
ALLOWED_GITHUB_OWNER=altmanAI
FOUNDER_APPROVAL_PHRASE=All Clear for Impact

# Repository-backed AI execution and authorization metadata.
AI_PARTNER_NAME=AltmanAI Model 2.0
AUTHORIZATION_RECORD_ID=ALTMANAI-CI-VERIFY-2026-07-13-001

# Required production authentication: GitHub App credentials.
# Store the private key as a platform secret. Literal newlines or escaped \n are
# accepted. Do not commit a real key.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Development fallback only. Leave blank in production.
GITHUB_TOKEN=
ALLOW_STATIC_GITHUB_TOKEN=false

GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
POLICY_PATH=./config/policy.json
VERIFICATION_PATH=./config/verification.json

# Mount durable encrypted storage at /app/data in production.
EVIDENCE_LEDGER_PATH=/app/data/evidence.ndjson
EVIDENCE_BACKUP_DIR=/app/data/backups
LEDGER_BACKUP_RETENTION_DAYS=30

# Optional operator metadata included in backup manifests.
DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_REGION=iad
